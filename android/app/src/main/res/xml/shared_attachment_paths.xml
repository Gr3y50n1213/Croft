<!-- T18b: the only files Croft's FileProvider can give to another app: attachments the person opened, saved by the core into
     cacheDir/shared-attachments/. Nothing else of Croft's has a URI (a test asserts this file lists this one path and no other). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared_attachments" path="shared-attachments/" />
</paths>
