<!-- T34d: the fdroid and github builds' push. The service is not exported; the connector library adds its receiver (exported, checked
     against the registration's token) and the distributor's foreground service binding (tools/manifest-allowlist.json, stores). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".push.CroftPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
