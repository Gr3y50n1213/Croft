{
  "name": "croft-web",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "The Croft web app, served by the Companion",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e": "playwright test --trace off"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
